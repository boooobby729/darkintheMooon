{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: 启动并在 Cursor 内预览",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "[-\\w]+:\\s*(https?://[^\\s]+)",
        "uriFormat": "%s"
      }
    }
  ]
}
