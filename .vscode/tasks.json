{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dev: 启动 Next.js",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "next",
        "pattern": { "regexp": "^.*$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Ready in \\d+ms"
        }
      },
      "presentation": { "reveal": "always", "panel": "new" }
    }
  ]
}
